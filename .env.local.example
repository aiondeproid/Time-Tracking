# このファイルをコピーして `.env.local` を作成し、値を埋める。
# `.env.local` は .gitignore 済み（コミットしないこと）。

# --- Supabase ---------------------------------------------------------------
# Supabase ダッシュボード → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role キー（全権限）。サーバー専用。NEXT_PUBLIC_ を付けないこと。
SUPABASE_SERVICE_ROLE_KEY=

# --- ログイン / 合言葉 ----------------------------------------------------
# 「名前の管理」のユーザー登録に要求する招待コード（サーバー専用）。
# ログイン自体は Supabase Auth（メール + パスワード）。ユーザー作成は
# サーバー側が service_role で行うため、Supabase の公開サインアップは無効でよい。
SIGNUP_CODE=

# サイト全体を保護する共通合言葉（サーバー専用）。
# 署名付きセッション Cookie の署名鍵もこの値から導出する。
SITE_PASSCODE=
