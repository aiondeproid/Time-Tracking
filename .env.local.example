# このファイルをコピーして `.env.local` を作成し、値を埋める。
# `.env.local` は .gitignore 済み（コミットしないこと）。

# --- データベース（SQLite） -------------------------------------------------
# DB ファイルの保存先。未指定なら <プロジェクト>/data/kintai.db。
# 初回起動時にファイルとテーブルが自動で作られる。
# DATABASE_PATH=C:\kintai\data\kintai.db

# --- ログイン（「名前の管理」） -----------------------------------------------
# 「名前の管理」を開くための管理用コード（サーバー専用）。ID・パスワードは無く、これだけで入れる。
# 推測されにくい長い値（12 文字以上推奨）にすること。変更するとログイン中の人は全員ログアウトされる。
# 未設定だと名前の管理は開けない。
SIGNUP_CODE=

# ログイン Cookie に Secure 属性を付けるか。HTTPS で公開する場合だけ true にする。
# 社内ネットワークで http://〜 のまま使うなら false（または未設定）のままにすること。
# SESSION_COOKIE_SECURE=false
